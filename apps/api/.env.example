# ---------- API ----------
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fintrack?retryWrites=true&w=majority
MONGO_DB=fintrack

# JWT Configuration
JWT_SECRET=change-me-in-prod-use-strong-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# OpenAI API (optional - Groq is recommended for free usage)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Groq API (free alternative to OpenAI)
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_MODEL=llama3-70b-8192

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# Configuration
LOG_LEVEL=INFO
ENV=production
